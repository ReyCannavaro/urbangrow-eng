# UrbanGrow Backend Environment Configuration
PORT=3000

# Gemini AI API (Dapatkan dari https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional Microservices (Default lokal)
AI_ENGINE_URL=http://localhost:8000
MQTT_BROKER_URL=mqtt://localhost:1883
DATABASE_URL=postgres://urbangrow_admin:urbangrow_secret_2026@localhost:5432/urbangrow

