# UrbanGrow Web Frontend Environment Configuration
# Copy this file to `.env.local` for local overrides or configure in Vercel Dashboard.
#
# Leave empty locally to use the Next.js `/api/*` rewrite (`http://localhost:3000`).
# In production (e.g. Vercel), point this to your AWS VPS HTTPS API URL:
# NEXT_PUBLIC_API_URL=https://api.urbangrow.yourdomain.com
NEXT_PUBLIC_API_URL=

